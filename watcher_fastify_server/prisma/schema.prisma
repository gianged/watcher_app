// Enhanced Prisma schema for Watcher App
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AppUser {
  id                Int               @id @default(autoincrement())
  username          String            @unique @db.VarChar(50)
  password          String            @db.VarChar(255)
  email             String            @unique @db.VarChar(100)
  phoneNumber       String?           @map("phone_number") @db.VarChar(20)
  firstName         String?           @map("first_name") @db.VarChar(50)
  lastName          String?           @map("last_name") @db.VarChar(50)
  avatar            String?           @db.VarChar(255)
  role              Role              @default(USER)
  isActive          Boolean           @default(true) @map("is_active")
  departmentId      Int?              @map("department_id")
  lastLoginAt       DateTime?         @map("last_login_at")
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdTickets    Ticket[]          @relation("TicketCreator")
  assignedTickets   Ticket[]          @relation("TicketAssignee")
  ticketComments    TicketComment[]
  createdAnnounces  Announce[]
  refreshTokens     RefreshToken[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  @@index([email])
  @@index([departmentId])
  @@map("app_user")
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  code        String?   @unique @db.VarChar(20)
  managerId   Int?      @map("manager_id")
  isActive    Boolean   @default(true) @map("is_active")
  users       AppUser[]
  tickets     Ticket[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("department")
}

model Ticket {
  id           Int             @id @default(autoincrement())
  ticketNumber String          @unique @map("ticket_number") @db.VarChar(50)
  title        String          @db.VarChar(200)
  description  String          @db.Text
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  createdById  Int             @map("created_by_id")
  assignedToId Int?            @map("assigned_to_id")
  departmentId Int?            @map("department_id")
  dueDate      DateTime?       @map("due_date")
  resolvedAt   DateTime?       @map("resolved_at")
  closedAt     DateTime?       @map("closed_at")
  createdBy    AppUser         @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   AppUser?        @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  comments     TicketComment[]
  attachments  Attachment[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  @@index([ticketNumber])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([departmentId])
  @@map("ticket")
}

model TicketComment {
  id        Int       @id @default(autoincrement())
  ticketId  Int       @map("ticket_id")
  userId    Int       @map("user_id")
  comment   String    @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comment")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @map("ticket_id")
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("attachment")
}

model Announce {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  content     String    @db.Text
  publishDate DateTime  @map("publish_date")
  expiryDate  DateTime? @map("expiry_date")
  isPinned    Boolean   @default(false) @map("is_pinned")
  isActive    Boolean   @default(true) @map("is_active")
  createdById Int       @map("created_by_id")
  createdBy   AppUser   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([publishDate])
  @@index([isPinned])
  @@map("announce")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_token")
}
